# LiftBig monorepo root. liftbig-api/ and liftbig-app/ keep their own .gitignore.

# Secrets and local-only files: never commit
db_pass
verification_code.txt
*.keystore
*.jks
keystore.properties
.env
.env.*
!.env.example
liftbig_dump.sql
*.zip

# Planning, notes and tooling: the private notes repo is cloned at /notes/; the root
# CLAUDE.md (an import stub), Plans.md and .harness link into it. Only docs/privacy/ is published.
/notes/
/Project Specification.*
/CLAUDE.md
/Plans.md
/spec.md
/docs/*
!/docs/privacy/
/liftbig-design-handoff/
/App icon*.png
/.harness
/.claude-code-harness.config.yaml
/.trail/
/.github/modernize/
/deploy_backend.sh
/test_api.js
/package-lock.json

# Generated or local output
node_modules/
Plans.md.bak.*
/brag-output/
/out/
# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
.DS_Store

# AI tools: settings, state, worktrees and instruction files, at any depth.
# The real CLAUDE.md files live in /notes/; the ones here are import stubs.
.claude/
.agents/
.harness/
.harness-worktrees/
.trail/
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.mcp.json
.codex/
.cursor/
.cursorrules
.cursorignore
.gemini/
GEMINI.md
.aider*
.continue/
.windsurf/
.windsurfrules
.serena/

# OpenTofu (infra/): state, saved plans and local variables stay out of git; the lock file is committed
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
