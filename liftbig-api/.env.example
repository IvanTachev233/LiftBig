# Reference for the API's local settings. Copy to .env (git-ignored) and fill in:
#   cp .env.example .env
# JWT_SECRET and the DB_USERNAME/DB_PASSWORD/DB_NAME trio are required;
# everything else has a local default (README § Environment variables).
# Variables already set in the shell win over this file.
# Never put production values here (no DATABASE_URL): production reads Secret
# Manager and the variables that scripts/deploy.sh sets.

# Signs access tokens and email codes; the API won't start without it.
# Generate one: openssl rand -base64 48
JWT_SECRET=

# The local postgres container: same values as POSTGRES_USER, POSTGRES_PASSWORD
# and POSTGRES_DB in liftbig-app/.env
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# DB_HOST=localhost
# DB_PORT=5433

# Schema handling: migrations run on start, no sync, in every environment
# (README § Changing the schema)
# RUN_MIGRATIONS=false
# TYPEORM_SYNC=true

# Access token lifetime and session limits
# JWT_ACCESS_TTL=15m
# REFRESH_IDLE_DAYS=30
# REFRESH_ABSOLUTE_DAYS=90

# HTTP port and extra CORS origins (comma-separated exact URLs)
# PORT=3000
# CORS_ORIGINS=

# Mail: unset MAIL_PROVIDER_KEY writes mails (codes included) to the log
# MAIL_PROVIDER_KEY=
# MAIL_FROM=LiftBig <codes@your-domain>

# Shown on /privacy and /terms
# PRIVACY_OPERATOR_NAME=
# PRIVACY_CONTACT_EMAIL=

# Minimum and latest Android versionCode for GET /app-config
# APP_MIN_VERSION_CODE=
# APP_LATEST_VERSION_CODE=

# Bug reports
# BUG_REPORT_BUCKET means screenshots aren't stored; unset
# GITHUB_FEEDBACK_TOKEN means GitHub status "disabled" and no GitHub call.
# Never put a real token here; add it as a Secret Manager version instead
# (README § Bug reports to GitHub).
# BUG_REPORTS_ENABLED=
# BUG_REPORT_BUCKET=
# GITHUB_FEEDBACK_TOKEN=
# GITHUB_FEEDBACK_REPO=IvanTachev233/LiftBig-Feedback

# Exercise demo media (ADR 0026): the public bucket's URL; unset means the
# exercise file's videoKey / imageKey give no media
# EXERCISE_MEDIA_BASE_URL=https://storage.googleapis.com/liftbigapi-media

# scripts/deploy.sh also reads GCP_PROJECT_ID, MAIL_FROM, CORS_ORIGINS, the
# PRIVACY_* values above, and when present BUG_REPORT_BUCKET,
# BUG_REPORTS_ENABLED, GITHUB_FEEDBACK_REPO and EXERCISE_MEDIA_BASE_URL from
# this file when they aren't in the environment
# GCP_PROJECT_ID=
